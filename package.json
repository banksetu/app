{
  "name": "app",
  "private": true,
  "version": "1.0.48",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-client-assets.mjs && tsc -b && vite build && node scripts/generate-sw.mjs",
    "check:schema": "node scripts/check-sheet-schema.mjs",
    "test:worker": "node --test cloudflare/worker.test.js",
    "release": "node scripts/release.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win nsis --publish never",
    "desktop:pack:unsigned": "npm run build && electron-builder --win nsis --publish never --config.win.signAndEditExecutable=false",
    "test:local": "node --test scripts/local-first.test.mjs scripts/offline-backup.test.mjs desktop/store.test.cjs desktop/testUpdater.test.cjs scripts/bank-pdf.test.mjs desktop/print-preview.test.cjs desktop/share-preview.test.cjs scripts/union-passbook.test.mjs desktop/app-protocol.test.cjs scripts/auth-navigation.test.mjs",
    "test:bridge": "node --test scripts/bridge.test.mjs",
    "predev": "node scripts/prepare-client-assets.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:updates": "node --test scripts/update-notice.test.mjs desktop/testUpdater.test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "electron-updater": "^6.8.9",
    "firebase": "^12.19.0",
    "html2canvas": "^1.4.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "playwright": "^1.58.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "in.banksetu.desktop",
    "productName": "Bank Setu",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "dist/**",
      "desktop/*.cjs",
      "!desktop/*.test.cjs",
      "package.json",
      "!desktop/*smoke.cjs"
    ],
    "asar": true,
    "win": {
      "artifactName": "BankSetu-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "banksetu",
        "repo": "app",
        "releaseType": "release"
      }
    ]
  }
}

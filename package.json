{
  "name": "app",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "check:schema": "node scripts/check-sheet-schema.mjs",
    "test:worker": "node --test cloudflare/worker.test.js",
    "release": "node scripts/release.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win nsis --publish never",
    "test:local": "node --test scripts/local-first.test.mjs desktop/store.test.cjs",
    "test:bridge": "node --test scripts/bridge.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "in.banksetu.desktop",
    "productName": "Bank Setu",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "dist/**",
      "desktop/*.cjs",
      "!desktop/*.test.cjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "banksetu",
        "repo": "app",
        "releaseType": "release"
      }
    ]
  }
}

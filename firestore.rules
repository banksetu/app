rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'active';
    }
    function approvedUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'active';
    }
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || admin());
      allow list: if admin();
      // Account provisioning is performed by trusted server code. Public
      // clients must not be able to assign themselves an application role.
      allow create: if false;
      allow update: if admin() && request.auth.uid != userId
        && resource.data.role == 'user'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'subscriptionStatus', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.status == 'approved' && request.resource.data.subscriptionStatus == 'active') ||
            (request.resource.data.status in ['pending', 'denied', 'blocked'] && request.resource.data.subscriptionStatus == 'inactive'));
      allow delete: if false;
    }
    match /appSettings/uiTheme {
      allow get: if approvedUser();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['dashboardTheme', 'menuTheme', 'customDashboardColor', 'useCustomDashboardColor', 'updatedBy'])
        && request.resource.data.keys().hasAll(['dashboardTheme', 'menuTheme', 'updatedBy'])
        && request.resource.data.dashboardTheme is string
        && request.resource.data.menuTheme is string
        && request.resource.data.updatedBy is string
        && (!('customDashboardColor' in request.resource.data) || request.resource.data.customDashboardColor is string)
        && (!('useCustomDashboardColor' in request.resource.data) || request.resource.data.useCustomDashboardColor is bool);
      allow delete: if false;
    }
    match /appSettings/{userId} {
      allow read, write: if userId != 'uiTheme'
        && signedIn() && request.auth.uid == userId
        && (admin() || (exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.status == 'approved'
          && get(/databases/$(database)/documents/users/$(userId)).data.subscriptionStatus == 'active'));
    }
  }
}
